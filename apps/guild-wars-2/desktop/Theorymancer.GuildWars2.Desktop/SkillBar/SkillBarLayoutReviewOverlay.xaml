<Window x:Class="Theorymancer.GuildWars2.Desktop.SkillBar.SkillBarLayoutReviewOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False">
  <Grid>
    <Canvas x:Name="OverlayCanvas" Background="#01000000" />
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Padding="12" Background="#D9111111" CornerRadius="4">
      <StackPanel>
        <TextBlock x:Name="MessageText" MaxWidth="500" Foreground="White" TextWrapping="Wrap" />
        <CheckBox x:Name="ShowOcrEvidenceCheckBox" Margin="0,8,0,0" Foreground="White" IsChecked="True" Checked="ShowOcrEvidence_Changed" Unchecked="ShowOcrEvidence_Changed" Content="Show temporary OCR evidence" />
        <TextBlock x:Name="DiagnosticsText" Margin="0,8,0,0" MaxWidth="700" FontFamily="Consolas" FontSize="11" Foreground="White" TextWrapping="Wrap" />
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="AcceptButton" Padding="12,5" Click="Accept_Click" Content="Save layout" />
          <Button Margin="8,0,0,0" Padding="12,5" Click="Cancel_Click" Content="Try again" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>

<Window x:Class="Theorymancer.GuildWars2.Desktop.Capture.WindowHighlightOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Grid IsHitTestVisible="False">
    <Border x:Name="HighlightBorder"
            BorderBrush="#FFFFD54F"
            BorderThickness="4"
            Background="#11000000"
            CornerRadius="4"
            Visibility="Collapsed">
      <Border HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="8"
              Padding="10,6"
              Background="#E6000000"
              CornerRadius="3">
        <TextBlock x:Name="HighlightLabel" Foreground="White" FontWeight="SemiBold" />
      </Border>
    </Border>
  </Grid>
</Window>

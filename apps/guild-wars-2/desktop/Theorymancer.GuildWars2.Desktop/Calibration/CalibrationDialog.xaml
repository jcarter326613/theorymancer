<Window x:Class="Theorymancer.GuildWars2.Desktop.Calibration.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Guild Wars 2 interface"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Calibrate interface regions" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                 Text="Both regions are required before recording. Calibration is saved for future sessions and only needs to be repeated after changing the Guild Wars 2 interface layout." />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Combat log" />
        <TextBlock Foreground="DimGray" FontSize="12" Text="Visible combat text used by the current collector." />
      </StackPanel>
      <TextBlock x:Name="CombatLogStatusText" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />
      <Button Grid.Column="2" Margin="16,0,0,0" Padding="12,6" Click="CalibrateCombatLog_Click" Content="Calibrate" />
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Skill bar" />
        <TextBlock Foreground="DimGray" FontSize="12" Text="Required now; its five weapon slots are reviewed before calibration is saved." />
      </StackPanel>
      <TextBlock x:Name="SkillBarStatusText" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" />
      <Button Grid.Column="2" Margin="16,0,0,0" Padding="12,6" Click="CalibrateSkillBar_Click" Content="Calibrate" />
    </Grid>

    <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Padding="12,6" Click="Cancel_Click" Content="Cancel" />
      <Button x:Name="SaveButton" Margin="8,0,0,0" Padding="12,6" Click="Save_Click" Content="Save calibration" />
    </StackPanel>
  </Grid>
</Window>

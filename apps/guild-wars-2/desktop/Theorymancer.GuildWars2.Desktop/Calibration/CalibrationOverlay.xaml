<Window x:Class="Theorymancer.GuildWars2.Desktop.Calibration.CalibrationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">
  <Grid>
    <Canvas x:Name="OverlayCanvas"
            Background="#01000000"
            Cursor="Cross"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseRightButtonDown="OnMouseRightButtonDown" />
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Padding="12" Background="#D9111111" CornerRadius="4">
      <StackPanel>
        <TextBlock x:Name="InstructionsText" Foreground="White" TextWrapping="Wrap" />
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="ConfirmButton" Padding="12,5" Click="Confirm_Click" Content="Use this region" IsEnabled="False" />
          <Button Margin="8,0,0,0" Padding="12,5" Click="Cancel_Click" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>

<Window x:Class="Theorymancer.GuildWars2.Desktop.Calibration.CalibrationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="OnKeyDown">
  <Canvas x:Name="OverlayCanvas"
          Cursor="Cross"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftButtonUp">
    <Rectangle x:Name="SelectionRectangle"
               Stroke="#FF3FA9F5"
               StrokeThickness="2"
               Fill="#223FA9F5"
               Visibility="Collapsed" />
    <Border Canvas.Left="20" Canvas.Top="20" Padding="12" Background="#D9111111" CornerRadius="4">
      <TextBlock Foreground="White" Text="Drag around the visible combat-log panel. Press Escape to cancel." />
    </Border>
  </Canvas>
</Window>

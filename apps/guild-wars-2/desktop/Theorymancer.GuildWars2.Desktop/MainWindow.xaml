<Window x:Class="Theorymancer.GuildWars2.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theorymancer GW2 Screen Collector"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="GW2 combat-log collector" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap">
        Captures the visible combat-log region. Calibrate both the combat log and skill bar before recording.
      </TextBlock>
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Theorymancer account:" />
        <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="{Binding AuthenticationStatus}" />
        <Button x:Name="SignInButton" Padding="10,4" Click="SignIn_Click" Content="Sign in" />
          <Button x:Name="SignOutButton" Margin="8,0,0,0" Padding="10,4" Click="SignOut_Click" Content="Sign out" />
        </StackPanel>
        <Border Margin="0,12,0,0" Padding="10" BorderBrush="Gainsboro" BorderThickness="1">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="ArenaNet build" />
            <TextBlock Margin="0,3,0,0" Foreground="DimGray" FontSize="12" TextWrapping="Wrap"
                       Text="Enter an API key with account, characters, and builds permissions. It is encrypted for this Windows user and is sent only to api.guildwars2.com." />
            <WrapPanel Margin="0,8,0,0">
              <PasswordBox x:Name="ArenaNetApiKeyBox" Width="300" Padding="7,4" VerticalContentAlignment="Center" />
              <Button Margin="8,0,0,0" Padding="10,4" Click="ConnectArenaNet_Click" Content="Connect key" />
              <Button Margin="8,0,0,0" Padding="10,4" Click="ClearArenaNetKey_Click" Content="Forget key" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <TextBlock VerticalAlignment="Center" Text="Character:" />
              <ComboBox x:Name="ArenaNetCharacterComboBox" Width="220" Margin="8,0,0,0" ItemsSource="{Binding ArenaNetCharacters}" SelectionChanged="ArenaNetCharacter_Changed" />
              <Button Margin="8,0,0,0" Padding="10,4" Click="LoadArenaNetBuild_Click" Content="Load active build" />
            </WrapPanel>
            <TextBlock Margin="0,6,0,0" Foreground="DimGray" FontSize="12" Text="{Binding ArenaNetStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Padding="12,6" Click="SelectWindow_Click" Content="Select GW2 window" />
      <Button Grid.Column="2" Padding="12,6" Click="Calibrate_Click" Content="Calibrate interface" />
      <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SetupStatus}" />
    </Grid>

    <Grid Grid.Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <CheckBox x:Name="DiagnosticsCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="DiagnosticsCheckBox_Changed" Unchecked="DiagnosticsCheckBox_Changed" Content="Enable diagnostics" />
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Activity" />
      </DockPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="ActivityList" FontFamily="Consolas" FontSize="12" ItemsSource="{Binding ActivityLog}" />
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
        <Border x:Name="DiagnosticsPanel" Grid.Column="2" Padding="12" BorderBrush="Gainsboro" BorderThickness="1" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Diagnostics" />
              <Border Margin="0,8,0,0" Padding="8" BorderBrush="Gainsboro" BorderThickness="1">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="Current cooldowns" />
                  <TextBlock Margin="0,3,0,0" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Text="{Binding CooldownMonitoringStatus}" />
                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding CooldownRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Margin" Value="0,2" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StartsSection}" Value="True">
                                  <Setter Property="Margin" Value="0,12,0,2" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" FontSize="11" Foreground="DimGray" Text="{Binding SlotLabel}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding SkillName}" />
                            <TextBlock FontSize="10" Foreground="DimGray" Text="{Binding StatusText}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="{Binding RemainingText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock x:Name="DiagnosticsSummaryText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
              <Button x:Name="RunDiagnosticOcrButton" Margin="0,12,0,0" Padding="10,5" HorizontalAlignment="Left" Click="RunDiagnosticOcr_Click" Content="Run diagnostic OCR" />
              <Separator Margin="0,16,0,12" />
              <TextBlock FontWeight="SemiBold" Text="Cooldown fixture capture" />
              <TextBlock Margin="0,4,0,0" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Text="After a 3-second delay, records the full skill bar as JPEG frames at 4 FPS. Stop after every tracked skill is available." />
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="StartFixtureCaptureButton" Padding="10,5" Click="StartFixtureCapture_Click" Content="Start fixture capture" />
                <Button x:Name="StopFixtureCaptureButton" Margin="8,0,0,0" Padding="10,5" Click="StopFixtureCapture_Click" Content="Stop" IsEnabled="False" />
              </WrapPanel>
              <TextBlock x:Name="FixtureCaptureStatusText" Margin="0,6,0,0" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Original crop" />
              <Border BorderBrush="Gainsboro" BorderThickness="1">
                <Image x:Name="OriginalDiagnosticPreview" Stretch="Uniform" />
              </Border>
              <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Combat-log OCR input" />
              <Border BorderBrush="Gainsboro" BorderThickness="1">
                <Image x:Name="ProcessedDiagnosticPreview" Stretch="Uniform" />
              </Border>
              <TextBlock Margin="0,6,0,0" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Text="Images remain in memory only while diagnostics are enabled." />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="6">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding CaptureStatus}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="StartButton" Padding="14,7" Click="Start_Click" Content="Start capture" />
        <Button x:Name="StopButton" Margin="8,0,0,0" Padding="14,7" Click="Stop_Click" Content="Stop capture" IsEnabled="False" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>

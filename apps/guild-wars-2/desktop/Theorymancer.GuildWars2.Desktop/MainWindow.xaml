<Window x:Class="Theorymancer.GuildWars2.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theorymancer GW2 Screen Collector"
        Width="760"
        Height="540"
        MinWidth="640"
        MinHeight="420"
        Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="GW2 combat-log collector" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap">
        Captures only the calibrated, visible combat-log region. Keep Guild Wars 2 visible and unobscured while recording.
      </TextBlock>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Padding="12,6" Click="SelectWindow_Click" Content="Select GW2 window" />
      <Button Grid.Column="2" Padding="12,6" Click="Calibrate_Click" Content="Calibrate combat log" />
      <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SetupStatus}" />
    </Grid>

    <StackPanel x:Name="CalibrationControls" Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Visibility="Collapsed">
      <TextBlock x:Name="CalibrationStatusText" VerticalAlignment="Center" Foreground="DimGray" />
      <Button x:Name="ConfirmCalibrationButton" Margin="12,0,0,0" Padding="12,6" Click="ConfirmCalibration_Click" Content="Confirm calibration" IsEnabled="False" />
      <Button Margin="8,0,0,0" Padding="12,6" Click="CancelCalibration_Click" Content="Cancel calibration" />
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="ActivityList" FontFamily="Consolas" FontSize="12" ItemsSource="{Binding ActivityLog}" />
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
      <Border x:Name="DiagnosticsPanel" Grid.Column="2" Padding="12" BorderBrush="Gainsboro" BorderThickness="1" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Capture diagnostics" />
            <TextBlock x:Name="DiagnosticsSummaryText" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            <Button x:Name="RunDiagnosticOcrButton" Margin="0,12,0,0" Padding="10,5" HorizontalAlignment="Left" Click="RunDiagnosticOcr_Click" Content="Run diagnostic OCR" />
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Original crop" />
            <Border BorderBrush="Gainsboro" BorderThickness="1">
              <Image x:Name="OriginalDiagnosticPreview" Stretch="Uniform" />
            </Border>
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="OCR input" />
            <Border BorderBrush="Gainsboro" BorderThickness="1">
              <Image x:Name="ProcessedDiagnosticPreview" Stretch="Uniform" />
            </Border>
            <TextBlock Margin="0,6,0,0" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Text="Images remain in memory only while diagnostics are enabled." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="6">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding CaptureStatus}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox x:Name="DiagnosticsCheckBox" Margin="0,0,12,0" VerticalAlignment="Center" Checked="DiagnosticsCheckBox_Changed" Unchecked="DiagnosticsCheckBox_Changed" Content="Enable diagnostics" />
        <Button x:Name="StartButton" Padding="14,7" Click="Start_Click" Content="Start capture" />
        <Button x:Name="StopButton" Margin="8,0,0,0" Padding="14,7" Click="Stop_Click" Content="Stop capture" IsEnabled="False" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>

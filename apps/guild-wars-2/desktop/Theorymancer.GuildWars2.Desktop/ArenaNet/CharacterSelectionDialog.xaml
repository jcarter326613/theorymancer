<Window x:Class="Theorymancer.GuildWars2.Desktop.ArenaNet.CharacterSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Guild Wars 2 character"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Character and account" />
      <TextBlock Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                 Text="Choose the Guild Wars 2 character whose active build supplies skill-bar candidates. Settings are saved for the next launch." />
      <WrapPanel Margin="0,12,0,0">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Theorymancer account:" />
        <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="{Binding AuthenticationStatus}" />
        <Button Padding="10,4" IsEnabled="{Binding CanSignIn}" Click="SignIn_Click" Content="Sign in" />
        <Button Margin="8,0,0,0" Padding="10,4" IsEnabled="{Binding CanSignOut}" Click="SignOut_Click" Content="Sign out" />
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="2" Padding="10" BorderBrush="Gainsboro" BorderThickness="1">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="ArenaNet build" />
        <TextBlock Margin="0,3,0,0" Foreground="DimGray" FontSize="12" TextWrapping="Wrap"
                   Text="Enter an API key with account, characters, and builds permissions. It is encrypted for this Windows user and sent only to api.guildwars2.com." />
        <WrapPanel Margin="0,8,0,0">
          <PasswordBox x:Name="ArenaNetApiKeyBox" Width="300" Padding="7,4" VerticalContentAlignment="Center" />
          <Button x:Name="ConnectKeyButton" Margin="8,0,0,0" Padding="10,4" Click="ConnectArenaNet_Click" Content="Connect key" />
          <Button Margin="8,0,0,0" Padding="10,4" Click="ClearArenaNetKey_Click" Content="Forget key" />
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <TextBlock VerticalAlignment="Center" Text="Character:" />
          <ComboBox Width="220" Margin="8,0,0,0" ItemsSource="{Binding ArenaNetCharacters}" SelectedItem="{Binding SelectedArenaNetCharacter, Mode=TwoWay}" />
          <Button x:Name="LoadBuildButton" Margin="8,0,0,0" Padding="10,4" Click="LoadArenaNetBuild_Click" Content="Load active build" />
        </WrapPanel>
        <TextBlock Margin="0,6,0,0" Foreground="DimGray" FontSize="12" Text="{Binding ArenaNetStatus}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Button Grid.Row="4" HorizontalAlignment="Right" Padding="12,6" Click="Close_Click" Content="Close" />
  </Grid>
</Window>

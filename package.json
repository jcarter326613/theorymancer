{
    "name": "theorymancer",
    "private": true,
    "packageManager": "pnpm@11.23.0",
    "scripts": {
        "dev": "pnpm run dev:all",
        "dev:api": "pnpm --filter @theorymancer/api dev",
        "dev:web": "pnpm --filter @theorymancer/web dev",
        "dev:all": "pnpm --parallel --filter @theorymancer/api --filter @theorymancer/web dev",
        "build": "pnpm -r build",
        "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0"
    }
}

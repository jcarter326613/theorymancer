{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Theorymancer: Web and API",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Theorymancer: Web in Chrome",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/apps/web",
            "preLaunchTask": "Dev: All"
        }
    ]
}
